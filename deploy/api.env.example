# senryo-api — Docker Image ghcr.io/blockchain-oracle/senryo-api:sha-<short>, port 3000, api.<rpId>, limit 384m.
# Names only (deploy-runbook §5). Real values: ~/.config/senryo/deploy/api.env (0600, outside the repo), applied with
# `coolify app env sync <uuid> --file …` — secrets Runtime-only (Build off), Literal when they contain `$`.
SERVICE=api
NODE_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000
# Coolify Postgres 17 "Internal URL" (senryo-ledger).
DATABASE_URL=
# Default chain + every served chain (10143 practice; add 143 after the S8 mainnet deploy).
CHAIN_ID=
CHAIN_IDS=
# Optional paid/extra RPCs (comma-separated); defaults come from @senryo/config.
RPC_HTTP=
RPC_WS=
SIWE_DOMAIN=
SIWE_URI=
CORS_ORIGINS=
MIN_APP_VERSION=
FEATURES=
# Internal URL of senryo-card (status page) and the Envio Hasura endpoint (S4).
CARD_URL=
INDEXER_GRAPHQL_URL=
STARTER_PER_DEVICE_PER_DAY=
STARTER_PER_NETWORK_PER_DAY=
# --- secrets (Runtime only) ---
# ≥ 32 bytes; shared with senryo-card.
API_SESSION_SECRET=
# StarterDrip RELAYER_ROLE key (testnet now; mainnet key is an [OK?] funding step).
SPONSOR_PK=
# Cloudflare Turnstile (web bot check); unset = native-only rate limits.
TURNSTILE_SECRET=

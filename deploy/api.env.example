# senryo-api — Docker Image ghcr.io/blockchain-oracle/senryo-api:sha-<short>, port 3000, api.<rpId>, limit 256m (D-272).
# Names only (deploy-runbook §5). Real values: ~/.config/senryo/deploy/api.env (0600, outside the repo), applied with
# `coolify app env sync <uuid> --file …` — secrets Runtime-only (Build off), Literal when they contain `$`.
SERVICE=api
NODE_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000
# Coolify Postgres 17 "Internal URL" (senryo-ledger).
DATABASE_URL=
# Default chain + every served chain (10143 Practice; add 143 after the S9 mainnet deploy).
CHAIN_ID=
CHAIN_IDS=
# Optional extra RPCs (comma-separated); defaults come from @senryo/config. Services only — apps make no RPC calls.
RPC_HTTP=
RPC_WS=
SIWE_DOMAIN=
SIWE_URI=
CORS_ORIGINS=
MIN_APP_VERSION=
# Only behind the CDN that sets it (e.g. cf-ipcountry); unset = DB-IP on the client IP (the Real money region rule).
TRUSTED_COUNTRY_HEADER=
SUPPORT_EMAIL=
SUPPORT_URL=
# Feature flags served by /v1/config, e.g. `earn=1,games=0`.
FEATURES=
# The indexer's Postgres schema (its ENVIO_PG_SCHEMA); history, leaderboard and proof read it. Default `envio`.
INDEXER_SCHEMA=
# --- secrets (Runtime only) ---
# ≥ 32 bytes.
API_SESSION_SECRET=
# Services' Monad RPC (D-272).
ALCHEMY_API_KEY=
# Aurora Intents Studio key (S9 any-chain deposits); unset → deposits answer `no_key`.
AURORA_API_KEY=
# Pyth Pro/Starter key — the PythGateway is its only holder (S3, D-272); header only, never in a URL or a client.
PYTH_API_KEY=
# Hermes base URL; unset → https://pyth.dourolabs.app/hermes (the documented one since the 26 Aug 2026 upgrade).
HERMES_ORIGIN=

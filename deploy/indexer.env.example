# senryo-indexer — Docker Image ghcr.io/blockchain-oracle/senryo-indexer:sha-<short>, port 9898 (health only, no
# domain), limit 512m (S4, D-272). Names only (deploy-runbook §5). Real values: ~/.config/senryo/deploy/indexer.env
# (0600, outside the repo), applied with `coolify app env sync <uuid> --file …` — secrets Runtime-only (Build off).
# HyperSync API token (Envio account; the indexer's only data source).
ENVIO_API_TOKEN=
# The shared ledger Postgres (Coolify "senryo-ledger" internal host), as its own role `senryo_indexer`: CONNECT +
# CREATE on the database (Envio drops and recreates its schema on a re-index), nothing on `public`.
ENVIO_PG_HOST=
ENVIO_PG_PORT=5432
ENVIO_PG_USER=senryo_indexer
ENVIO_PG_PASSWORD=
ENVIO_PG_DATABASE=senryo
# Envio's tables live here; the api's INDEXER_SCHEMA must match.
ENVIO_PG_SCHEMA=envio
# Private network, no TLS (NODE_ENV=production drops Envio's dev fallbacks, so it is explicit).
ENVIO_PG_SSL_MODE=false
ENVIO_HASURA=false
LOG_LEVEL=info

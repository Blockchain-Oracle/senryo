# senryo-card — same image as api (SERVICE=card), port 3001, routed at api.<rpId>/v1/card/*, limit 192m.
# Names only (deploy-runbook §5); secrets Runtime-only.
SERVICE=card
NODE_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3001
DATABASE_URL=
CHAIN_ID=
RPC_HTTP=
RPC_WS=
INTERNAL_DEADLINE_MS=
WEBHOOK_TOLERANCE_S=
FX_BUFFER_BPS=
TIP_BUFFER_BPS=
# Hashed into the onchain issuer; mainnet sets releaseOnly for it (D-036).
CARD_ISSUER_LABEL=
CARD_RELEASE_ONLY=
LITHIC_API_BASE=
# --- secrets (Runtime only) ---
# Lithic ASA HMAC secret (whsec_…), events webhook secret (whsec_…), sandbox API key — Lithic account is an [OK?].
LITHIC_ASA_SECRET=
LITHIC_WEBHOOK_SECRET=
LITHIC_API_KEY=
# Same value as senryo-api.
API_SESSION_SECRET=
# CARD_OPERATOR_ROLE keys, sharded by account (add OPERATOR_3_PK … up to 8).
OPERATOR_1_PK=
OPERATOR_2_PK=

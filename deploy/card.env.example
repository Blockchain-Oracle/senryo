# senryo-card — same image as api (SERVICE=card), port 3001, routed at api.<rpId>/v1/card/*, limit 192m.
# Names only (deploy-runbook §5); secrets Runtime-only. Any secret may instead be given as NAME_FILE=<path>.
SERVICE=card
NODE_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3001
DATABASE_URL=
# 10143 (testnet / Practice) or 143 (mainnet).
CHAIN_ID=
# Comma-separated overrides; empty → packages/config defaults for CHAIN_ID.
RPC_HTTP=
RPC_WS=
# Optional tuning (defaults: 2800 ms decision deadline, 300 s signature tolerance, 300 bps FX, 2000 bps tip buffer).
INTERNAL_DEADLINE_MS=
WEBHOOK_TOLERANCE_S=
FX_BUFFER_BPS=
TIP_BUFFER_BPS=
# Hashed into the onchain issuer (default lithic-sandbox); mainnet sets releaseOnly for it (D-036).
CARD_ISSUER_LABEL=
CARD_RELEASE_ONLY=
# Default https://sandbox.lithic.com — simulate is refused anywhere else.
LITHIC_API_BASE=https://sandbox.lithic.com
# Card program (BIN range) for issued cards; empty → the program default.
# Sandbox test programs: 00000000-0000-0000-1000-000000000000 · 00000000-0000-0000-2000-000000000000.
LITHIC_CARD_PROGRAM_TOKEN=
# --- secrets (Runtime only) ---
# Sandbox API key (issue, freeze/unfreeze, simulate, reveal). Unset → those routes answer ISSUER_UNAVAILABLE.
LITHIC_API_KEY=
# ASA HMAC secret (whsec_…) from GET /v1/auth_stream/secret. Unset → every ASA request is rejected (a decline).
LITHIC_ASA_SECRET=
# Events webhook secret (whsec_…) from GET /v1/event_subscriptions/{token}/secret. Unset → lifecycle events rejected.
LITHIC_WEBHOOK_SECRET=
# Same value as senryo-api (verifies the app's SIWE session token).
API_SESSION_SECRET=
# CARD_OPERATOR_ROLE keys, sharded by account (add OPERATOR_3_PK … up to OPERATOR_8_PK); each needs MON for gas.
OPERATOR_1_PK=
OPERATOR_2_PK=

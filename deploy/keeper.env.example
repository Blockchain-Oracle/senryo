# senryo-keeper — same image as api (SERVICE=keeper), port 3002 (internal only, no domain), limit 256m (D-124).
# Names only (deploy-runbook §5); secrets Runtime-only.
SERVICE=keeper
NODE_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3002
DATABASE_URL=
CHAIN_ID=
RPC_HTTP=
RPC_WS=
# /health fails when the scheduler is older than this.
KEEPER_STALE_SEC=
# liquidate,observe,mirror,triggers,holds,alerts,wallets,retention (mirror needs MIRROR_ROLE). Gas top-ups moved to the api (D-171).
KEEPER_JOBS=
KEEPER_WATCH_ACCOUNTS=
INDEXER_GRAPHQL_URL=
# Mainnet RPC for the Chainlink source of the testnet mirror relay.
SOURCE_RPC_HTTP=
MIRROR_MARKETS=
MIRROR_DEVIATION_BPS=
MIRROR_HEARTBEAT_SEC=
WALLET_FLOOR_WEI=
OPS_WATCH_WALLETS=
LIQUIDATE_MS=
OBSERVE_MS=
MIRROR_MS=
# --- secrets (Runtime only) ---
# Keeper key (MIRROR_ROLE on testnet).
KEEPER_PK=

# senryo-keeper — same image as api (SERVICE=keeper), port 3002 (internal only, no domain), limit 160m (D-272).
# Names only (deploy-runbook §5); secrets Runtime-only.
SERVICE=keeper
NODE_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3002
DATABASE_URL=
CHAIN_ID=
RPC_HTTP=
RPC_WS=
# /health fails when the scheduler is older than this.
KEEPER_STALE_SEC=
# retention,receipts,pushes (default: all). S3 adds finalize,settle,payouts,void-stale. An explicit list must include
# `receipts` (dead Expo device tokens are disabled) and `pushes` (recorded notifications are pushed and retried, G1).
KEEPER_JOBS=
# User pushes through Expo (default on); `off` records push_sends (the inbox) and logs only.
PUSH_DELIVERY=
# --- secrets (Runtime only) ---
# Keeper key (S3: finalize/settle/claimFor sender; kept ≥ 12 MON).
KEEPER_PK=
# Optional: only once enhanced push security is enabled on the EAS project (expo.dev access tokens).
EXPO_ACCESS_TOKEN=
# Break-glass only (S3): used once when no `pyth_prints` row exists by T+10 s; the api's gateway is the normal path.
PYTH_API_KEY=

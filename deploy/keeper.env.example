# senryo-keeper — same image as api (SERVICE=keeper), port 3002 (internal only, no domain), limit 256m (D-124).
# Names only (deploy-runbook §5); secrets Runtime-only.
SERVICE=keeper
NODE_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3002
DATABASE_URL=
CHAIN_ID=
RPC_HTTP=
RPC_WS=
# /health fails when the scheduler is older than this.
KEEPER_STALE_SEC=
# liquidate,observe,mirror,triggers,holds,alerts,wallets,retention,sweeps,receipts (mirror needs MIRROR_ROLE). Gas
# top-ups moved to the api (D-171). An explicit list must include `sweeps` or deposit inboxes are never credited (S8.24),
# and `receipts` or Expo push receipts are never checked (dead device tokens stay enabled).
KEEPER_JOBS=
KEEPER_WATCH_ACCOUNTS=
INDEXER_GRAPHQL_URL=
# Mainnet RPC for the Chainlink source of the testnet mirror relay.
SOURCE_RPC_HTTP=
# XAU,XAG + EUR,GBP,JPY,CHF,CAD once AddMarkets.s.sol run 1 has deployed the FX mirrors (S8.23).
MIRROR_MARKETS=
MIRROR_DEVIATION_BPS=
MIRROR_HEARTBEAT_SEC=
# FX mirrors relay cadence (default 9000 s, under the oracle's 10,800 s FX mirror heartbeat + grace).
MIRROR_FX_HEARTBEAT_SEC=
# observe budget: with open interest, poke once the feed drifts this far from the persisted price (default 100).
OBSERVE_DRIFT_BPS=
WALLET_FLOOR_WEI=
OPS_WATCH_WALLETS=
LIQUIDATE_MS=
OBSERVE_MS=
MIRROR_MS=
SWEEPS_MS=
# Deposit inbox sweep threshold in usd6 (default 1000000 = $1); the keeper pays the deploy + sweep gas.
SWEEP_MIN_USD6=
# User pushes through Expo (default on); `off` records push_sends and logs only.
PUSH_DELIVERY=
# --- secrets (Runtime only) ---
# Keeper key (MIRROR_ROLE on testnet).
KEEPER_PK=
# Optional: only once enhanced push security is enabled on the EAS project (expo.dev access tokens).
EXPO_ACCESS_TOKEN=

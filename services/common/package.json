{
  "name": "@senryo/service-common",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared server runtime for services/{api,card,keeper}: env + key loading, pino, Fastify base (liveness /health), Postgres ledger client and forward-only migrations, latency samples.",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "migrate": "tsx src/migrate-cli.ts",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@senryo/api-client": "workspace:*",
    "@senryo/chain": "workspace:*",
    "@senryo/config": "workspace:*",
    "@senryo/contracts": "workspace:*",
    "@senryo/core": "workspace:*",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}

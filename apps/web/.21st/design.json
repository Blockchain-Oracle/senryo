{
  "version": 1,
  "project": {
    "name": "@senryo/web",
    "productType": "fintech trading app (Senryo 千両 + Kinpaku 金箔 card, Monad)",
    "stack": ["nextjs-16-static-export", "react-19", "tailwind-v4", "shadcn"]
  },
  "direction": {
    "name": "Living Lacquer",
    "summary": "Fomo's rounded trading interface and dark violet surfaces + Phantom's contextual action fan + Solflare's illustrated onboarding and material artwork; Senryo's seal, gold leaf and lacquer are the identity inside that language. The reference study is the minimum baseline.",
    "approved": "D-168 (user, 30 Sep 2026); docs/design/senryo-v2/direction.md; docs/plan/v2-plan.md §5",
    "supersedes": "D2 Desk (D-004, design/DIRECTIONS.md, design/screens/d2-*) — history only",
    "web": "Web inherits the tokens now; its layouts follow in S11b with the same route/state contracts (desktop dock = declared adaptation, direction §11)."
  },
  "sources": {
    "tokens": [
      "packages/tokens/src/palette.ts",

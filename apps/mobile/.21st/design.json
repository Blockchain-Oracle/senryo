    "typography": {
      "fonts": {
        "sans": "Inter 400/500/600/700 (Inter 4.1 static TTF, rsms/inter, OFL) — UI",
        "display": "Inter Display SemiBold (Inter 4.1 static) — big numbers and titles ≥ 32 pt, −0.02 em",
        "jp": "Noto Sans JP, subset to the glyphs we ship (千両金箔), OFL — Japanese only; the seal stays vector"
      },
      "figures": "tabular + lining (tnum, lnum) for money, quotes, fees and aligned columns",
      "case": "sentence/title case; no tracked uppercase",
      "roles": {
        "displayBalance": "52/56 Inter Display 600 (Home balance)",
        "displayMargin": "64/68 Inter Display 600 (ticket margin)",
        "displayPrice": "40/44 Inter Display 600 (market price)",
        "pageTitle": "32/38 Inter Display 600",
        "sheetTitle": "24/28 600",
        "sectionTitle": "20/24 600",
        "body": "16/22",
        "row": "16/20 500",
        "rowAmount": "16/20 600 numeric",
        "meta": "12/16",
        "moneyMeta": "12/16 500 numeric",
        "buttonLabel": "16/20 600",
        "buttonCompact": "14/20 600",
        "tabLabel": "12/16 600",
        "chipLabel": "12/16 500",
        "modeLabel": "12/16 600",
        "fanLabel": "24/28 600",
        "legacy": "micro/label/caption 12/16 · body/bodyStrong 16/22 · title 20/24 · numSm 16/20 · numMd 20/24 · numTicker/numLg 40/44 · numXl/numHero 52/56"
      },
      "source": "packages/tokens/src/scale.ts (TYPE) → tokens.css --type-* → Tailwind text-<role>; apps/mobile/src/theme/type.ts"
    },
    "radius": {
      "scale": "8 / 12 / 16 / 24 / 32 / pill",
      "use": "chips · inputs · action rows · cards and sheet tops · onboarding hero · buttons, dock, fan, avatars",
      "compat": "RADIUS.sm = 12 for components not rebuilt yet",
      "source": "packages/tokens/src/scale.ts RADIUS"
    },
    "spacing": {
      "grid": "4 pt (2 = optical micro-gap only)",
      "screenInset": 20,
      "rowMinHeight": 64,
      "touchTarget": 44,
      "source": "packages/tokens/src/scale.ts SPACE; apps/mobile/src/theme/layout.ts SIZE/DOCK/FAN"
    },
    "motion": {
      "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "families": {
        "press": "100 ms",
        "selection": "170 ms",
        "pagePush": "320 ms",
        "compactSelector": "~420 ms, spring 1/260/30 clamped (M02)",
        "tallDetail": "~450 ms, spring 1/240/30 clamped (M07/M08/M13)",
        "parentChild": "~600 ms (M16)",
        "fan": "200 ms/item, 25 ms stagger, spring 1/420/30; Send overshoots; backdrop 160; plus→× 180 (45°); exit 180 (M06)",
        "dockActive": "260 ms, spring 1/500/36 (M10)",
        "headerCollapse": "scroll-driven over 132 pt (M09)",
        "rulerSnap": "direct gesture, snap 1/500/40 (M14)",
        "numbers": "160 ms on real change only",
        "chartReveal": "750 ms after data (M08)",
        "onboardingScene": "850 ms (M01)",
        "qr": "650 ms, valid payload (M04)",
        "ambient": "8 s loops",
        "completionFoil": "800 ms after the real outcome (M18)"
      },
      "reducedMotion": "static art, ~100 ms crossfades; reduced transparency → opaque glass/fan backdrop",
      "haptics": "selection ticks, one on submit, one on the confirmed outcome; no sound by default",
      "source": "packages/tokens/src/scale.ts MOTION/SPRING; apps/mobile/src/theme/motion.ts"
    },
    "materials": {
      "glass": "dock only (expo-glass-effect on iOS 26; blur + glassTint elsewhere; glassOpaque under reduced transparency)",
      "blur": "strong live blur only behind the fan (expo-blur) + fanScrim",
      "dim": "ordinary sheets dim the parent (sheetScrim); no universal sheet blur",
      "elevation": "dock 0/8/24 #00000033; sheet 0/−4/16 #0000001F; raised content has no shadow",
      "ramps": "gold leaf #886426/#D4AE5B/#FFF0BC · silver #697383/#C9D0DD/#F4F6FB · lacquer #17121B/#29212F/#514357 (artwork only)",
      "gold": "gold identifies Senryo and Kinpaku; never buy, profit, warning or mainnet"
    },
    "density": "comfortable: rounded controls, rows ≥ 64, 20 pt inset",
    "must": [
      "Reference evidence first: every component names its C/F/M evidence IDs and declared deviations here before it is built",
      "Colours only from @senryo/tokens (theme/ on mobile, tokens.css on web); no hex/rgba elsewhere",
      "Known entities render their real first-party mark (EntityMark, @senryo/identity); Lucide icons identify actions only",
      "Mode capsule ('Practice · Paper money' violet / 'Mainnet · Real money' blue) on every money surface; P$ for paper",
      "Success only after finalization; the 500 ms hold confirms (D-177) with an accessible explicit alternative",
      "Reading<T>: skeleton → value → stale/unavailable; never a fabricated $0.00 or tick",
      "Content padded clear of the dock; tab, stack and scroll restored; parents restored after every sheet"
    ],
    "avoid": [
      "D2 terminal identity: pure black, monospace amounts, green/yellow primaries, 4 px corners, hairline grids, tracked caps",
      "universal sheet blur, literal radial fans, flat-logo 'material' wobble",
      "success flourishes on submit; celebratory motion before the real outcome",
      "generic coins, letter discs or recoloured approximations for known entities",
      "an available component dictating layout or dropping states (C40 is never a plain slider)",
      "fictitious 21st attribution for a custom reconstruction",
      "framer-motion imports (use motion/react on web); floats for money"
    ]
  },

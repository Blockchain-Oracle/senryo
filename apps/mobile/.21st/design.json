    "typography": {
      "fonts": {
        "sans": "Inter (next/font; labels, prose)",
        "mono": "JetBrains Mono (every number, tabular + slashed zero)"
      },
      "roles": {
        "micro": "10/14 mono uppercase tracked 0.12em — column heads, chips",
        "label": "11/14 uppercase tracked 0.12–0.2em — section labels",
        "caption": "12/16",
        "body": "14/20",
        "title": "17/22 semibold",
        "num-sm": "13/18 mono",
        "num-md": "16/22 mono",
        "num-ticker": "24/30 mono semibold",
        "num-lg": "28/34 mono",
        "num-xl": "34/40 mono — equity hero",
        "num-hero": "40/46 mono"
      },
      "source": "packages/tokens/src/scale.ts (TYPE) → tokens.css --type-* → Tailwind text-<role>"
    },
    "radius": {
      "base": "4px (--radius 0.25rem)",
      "scale": "xs .5× · sm .6× · md .8× · lg 1× · xl 1.4× · 2xl 1.8×",
      "pill": "999 for dots/toggles only"
    },
    "spacing": {
      "grid": "4px",
      "source": "packages/tokens/src/scale.ts SPACE"
    },
    "motion": {
      "durations_ms": {
        "fast": 120,
        "base": 160,
        "slow": 200
      },
      "easing": "cubic-bezier(0.2, 0, 0, 1)",
      "rules": [
        "nothing bounces (no spring overshoot except sheets)",
        "path draw on charts",
        "spinner only on the active execution step",
        "number changes roll (Number Flow) with timing, not spring",
        "prefers-reduced-motion collapses to instant"
      ]
    },
    "density": "high",
    "must": [
      "Colours only from @senryo/tokens (tokens.css / PALETTES) — no hex or px in components",
      "JetBrains Mono tabular for every number; ▲▼ plus a sign with every up/down colour",
      "1px hairlines, 4px radius, no shadows; dense rows; uppercase tracked mono labels",
      "Network label (PRACTICE/MAINNET) on every money surface; PREVIEW DATA badge while sample data is shown",
      "Reading<T>: skeleton → value → stale label; never a fabricated $0.00; success shown in place, not as a toast",
      "Every component is a 21st item (search → preview → get → add → re-tokenize); record its source id here"
    ],
    "avoid": [
      "gradients, glass, glow and drop shadows (the Kinpaku foil on the card is the only gradient)",
      "bouncy springs, confetti, celebratory motion",
      "rounded-2xl consumer cards, pill buttons",
      "framer-motion imports (use motion/react)",
      "invented components with no 21st source",
      "floats for money"
    ]
  },

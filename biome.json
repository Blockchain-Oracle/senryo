{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!context",
      "!design",
      "!references",
      "!prompts",
      "!docs",
      "!**/generated",
      "!apps/web/public/.well-known",
      "!**/abis",
      "!contracts",
      "!indexer/generated",
      "!.claude",
      "!packages/tokens/src/tokens.css",
      "!packages/identity/sources",
      "!brand/art",
      "!apps/mobile/assets/onboarding/labels.json",
      "!packages/config/src/market-order.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noMagicNumbers": "error",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 400
          }
        },
        "noNonNullAssertion": "error",
        "useConst": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["error", "warn"]
          }
        }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/constants/**",
        "**/constants.ts",
        "packages/config/**",
        "packages/tokens/**",
        "apps/mobile/src/theme/**",
        "apps/mobile/src/lib/sample.ts",
        "scripts/invariants/**",
        "packages/core/src/market/lnwad.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**", "**/scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["indexer/schema.graphql"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}

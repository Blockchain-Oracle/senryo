# Senryo indexer — names only (values live in ~/.config/senryo/ locally or Coolify runtime env; never committed).
# The markets schema, handlers and this deploy are rebuilt in S4 (Envio 3.14, D-272: Hasura off, tables on the shared
# Postgres under their own schema, read by the api over SQL). Until then this matches docker-compose.yaml.
# Required by docker-compose.yaml (the deploy fails while empty):
ENVIO_API_TOKEN=
ENVIO_PG_PASSWORD=
HASURA_GRAPHQL_ADMIN_SECRET=
# Image tag from the images workflow (sha-<short>); the deploy pulls ghcr.io/blockchain-oracle/senryo-indexer.
INDEXER_IMAGE_TAG=

# Optional (empty = defaults in config.yaml):
ENVIO_PG_USER=
ENVIO_PG_DATABASE=
LOG_LEVEL=
LOG_STRATEGY=
# Start blocks: the markets contracts' deploy blocks (S2 testnet, S9 mainnet).
ENVIO_START_BLOCK_10143=
ENVIO_START_BLOCK_143=
# Skip mainnet until S9 (true/false).
ENVIO_SKIP_143=
# Fallback RPC per chain; HyperSync is the supported data source (public RPCs cap eth_getLogs at 100 blocks).
ENVIO_RPC_URL_143=
ENVIO_RPC_URL_10143=

# Senryo indexer — names only (values live in ~/.config/senryo/ locally or Coolify runtime env; never committed).
# Required by docker-compose.yaml (the deploy fails while empty):
ENVIO_API_TOKEN=
ENVIO_PG_PASSWORD=
HASURA_GRAPHQL_ADMIN_SECRET=
# Image tag from the images workflow (sha-<short>); the deploy pulls ghcr.io/blockchain-oracle/senryo-indexer.
INDEXER_IMAGE_TAG=

# Optional (empty = defaults in config.yaml / src/lib/constants.ts):
ENVIO_PG_USER=
ENVIO_PG_DATABASE=
LOG_LEVEL=
LOG_STRATEGY=
# Mainnet launch block for Perpl's noisy events (S8 sets it); our Perpl builder id once Perpl assigns it (Q-003)
ENVIO_APP_LAUNCH_BLOCK_143=
ENVIO_PERPL_BUILDER_ID=
# Mainnet start blocks: chain, Perpl metadata/accounts, Chainlink rounds (candle history), wildcard aggregator watch
ENVIO_START_BLOCK_143=
ENVIO_PERPL_START_BLOCK_143=
ENVIO_FEED_START_BLOCK_143=
ENVIO_FEED_WATCH_START_BLOCK_143=
# Skip mainnet entirely (true/false)
ENVIO_SKIP_143=
# RPCs: fallback RPC per chain; `sync` makes the RPC the data source instead of HyperSync (public RPCs cap
# eth_getLogs at 100 blocks and 25–50 req/s — HyperSync is the supported path)
ENVIO_RPC_URL_143=
ENVIO_RPC_URL_10143=
ENVIO_RPC_FOR_143=
ENVIO_RPC_FOR_10143=
# Archive RPCs for Effect reads at the event block (SenryoCore.account, Chainlink proxy phases)
ENVIO_ARCHIVE_RPC_URL_143=
ENVIO_ARCHIVE_RPC_URL_10143=
